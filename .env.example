# ---------------------------------------------------------------------------
# Fulgor Burger — variables de entorno
# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
# ---------------------------------------------------------------------------

# Conexión a PostgreSQL. Con docker compose local:
DATABASE_URL=postgres://fulgor:fulgor_local_dev@localhost:5433/fulgor
# Activa SSL para bases gestionadas (Neon, Supabase, Railway, RDS…)
DATABASE_SSL=false
# Conexiones máximas del pool por instancia
DATABASE_POOL_MAX=10

# Secreto largo y aleatorio (mín. 32 caracteres). Se usa para anonimizar IP y
# teléfonos en el control de abuso. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Secreto para el endpoint programado que publica las fechas semanales
# (GET /api/cron/slots con cabecera Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# URL pública del sitio (metadatos, enlaces absolutos y vista previa social).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para crear el primer administrador con `pnpm admin:create`.
# Bórralas del entorno después de usarlas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
